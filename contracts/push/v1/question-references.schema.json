                    ]
                  }
                },
                "required": [
                  "question_id",
                  "session_id",
                  "kind",
                  "state",
                  "expires_at"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "question_id": {
