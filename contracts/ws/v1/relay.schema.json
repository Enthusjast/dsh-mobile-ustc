{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-mobile-ustc.invalid/contracts/ws/v1/relay.schema.json",
  "title": "DSH Mobile Relay frames implemented in the M1 session-catalog increment",
  "description": "Strict frame schemas for challenge proof, heartbeat, text command routing, host session-catalog synchronization, and bounded protocol errors. Session content subscriptions remain unimplemented.",
  "oneOf": [
    { "$ref": "#/$defs/challenge" },
    { "$ref": "#/$defs/deviceHelloProof" },
    { "$ref": "#/$defs/hostHelloProof" },
    { "$ref": "#/$defs/deviceHelloOk" },
    { "$ref": "#/$defs/hostHelloOk" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/pong" },
    { "$ref": "#/$defs/hostSessionCatalog" },
    { "$ref": "#/$defs/hostSessionCatalogAck" },
    { "$ref": "#/$defs/messageSubmit" },
    { "$ref": "#/$defs/messageSubmitToHost" },
    { "$ref": "#/$defs/hostCommandReceipt" },
    { "$ref": "#/$defs/deviceCommandReceipt" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/accessRevoked" },
    { "$ref": "#/$defs/runtimeChanged" },
    { "$ref": "#/$defs/serverDraining" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proof": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "capability": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "workspaces", "sessions"],
      "properties": {
        "actions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "workspaces": { "type": "array", "items": { "$ref": "#/$defs/uuid" }, "uniqueItems": true },
        "sessions": { "type": "array", "items": { "$ref": "#/$defs/uuid" }, "uniqueItems": true }
      }
    },
    "textContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1, "maxLength": 32768, "pattern": "\\S" }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "challenge" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["connection_id", "challenge_id", "nonce", "role", "expires_at"],
          "properties": {
            "connection_id": { "$ref": "#/$defs/uuid" },
            "challenge_id": { "$ref": "#/$defs/uuid" },
            "nonce": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$" },
            "role": { "enum": ["device", "installation"] },
            "expires_at": { "type": "string" }
          }
        }
      }
    },
    "deviceHelloProof": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "hello.proof" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["proof", "device_id", "protocols", "capabilities"],
          "properties": {
            "proof": { "$ref": "#/$defs/proof" },
            "device_id": { "$ref": "#/$defs/uuid" },
            "protocols": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "integer", "minimum": 1, "maximum": 32 }, "uniqueItems": true },
            "capabilities": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true }
          }
        }
      }
    },
    "hostHelloProof": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "hello.proof" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["proof", "runtime_id", "runtime_epoch", "dsh_version", "application_version", "plugin_version", "protocol_version", "capabilities"],
          "properties": {
            "proof": { "$ref": "#/$defs/proof" },
            "runtime_id": { "$ref": "#/$defs/uuid" },
            "runtime_epoch": { "$ref": "#/$defs/uuid" },
            "dsh_version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "application_version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "plugin_version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "protocol_version": { "type": "integer", "minimum": 1, "maximum": 32 },
            "capabilities": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true }
          }
        }
      }
    },
    "deviceHelloOk": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "hello.ok" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["role", "connection_id", "device_id", "runtime_id", "grant_version", "scope", "protocols", "capabilities", "server_time", "heartbeat_seconds", "max_frame_bytes", "lease_expires_at"],
          "properties": {
            "role": { "const": "device" }, "connection_id": { "$ref": "#/$defs/uuid" },
            "device_id": { "$ref": "#/$defs/uuid" }, "runtime_id": { "$ref": "#/$defs/uuid" },
            "grant_version": { "type": "integer", "minimum": 1 }, "scope": { "$ref": "#/$defs/scope" },
            "protocols": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true },
            "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true },
            "server_time": { "type": "string" }, "heartbeat_seconds": { "const": 20 },
            "max_frame_bytes": { "const": 65536 }, "lease_expires_at": { "type": "string" }
          }
        }
      }
    },
    "hostHelloOk": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "hello.ok" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["role", "connection_id", "installation_id", "runtime_id", "runtime_epoch", "protocol_version", "protocols", "capabilities", "server_time", "heartbeat_seconds", "max_frame_bytes", "lease_expires_at"],
          "properties": {
            "role": { "const": "host" }, "connection_id": { "$ref": "#/$defs/uuid" },
            "installation_id": { "$ref": "#/$defs/uuid" }, "runtime_id": { "$ref": "#/$defs/uuid" },
            "runtime_epoch": { "$ref": "#/$defs/uuid" }, "protocol_version": { "type": "integer", "minimum": 1 },
            "protocols": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true },
            "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true },
            "server_time": { "type": "string" }, "heartbeat_seconds": { "const": 20 },
            "max_frame_bytes": { "const": 65536 }, "lease_expires_at": { "type": "string" }
          }
        }
      }
    },
    "ping": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "payload"],
      "properties": { "v": { "const": 1 }, "type": { "const": "ping" }, "payload": { "type": "object", "maxProperties": 0 } }
    },
    "pong": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "pong" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["connection_id", "server_time"], "properties": { "connection_id": { "$ref": "#/$defs/uuid" }, "server_time": { "type": "string" } } }
      }
    },
    "messageSubmit": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "request_id", "runtime_id", "session_id", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "message.submit" },
        "request_id": { "$ref": "#/$defs/uuid" }, "runtime_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/uuid" }, "payload": { "$ref": "#/$defs/submitPayload" }
      }
    },
    "messageSubmitToHost": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "request_id", "runtime_id", "runtime_epoch", "session_id", "user_id", "device_id", "payload_sha256", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "message.submit" },
        "request_id": { "$ref": "#/$defs/uuid" }, "runtime_id": { "$ref": "#/$defs/uuid" },
        "runtime_epoch": { "$ref": "#/$defs/uuid" }, "session_id": { "$ref": "#/$defs/uuid" },
        "user_id": { "$ref": "#/$defs/uuid" }, "device_id": { "$ref": "#/$defs/uuid" },
        "payload_sha256": { "$ref": "#/$defs/sha256" }, "payload": { "$ref": "#/$defs/submitPayload" }
      }
    },
    "submitPayload": {
      "type": "object", "additionalProperties": false, "required": ["mode", "content"],
      "properties": {
        "mode": { "enum": ["queue", "steer"] },
        "content": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/textContent" } }
      }
    },
    "sessionCatalogItem": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "dsh_session_id", "workspace_id", "state", "last_persisted_seq"],
      "properties": {
        "session_id": { "$ref": "#/$defs/uuid" },
        "dsh_session_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "workspace_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "state": { "enum": ["available", "running", "archived", "unavailable"] },
        "last_persisted_seq": { "type": "integer", "minimum": -1 }
      }
    },
    "hostSessionCatalog": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "request_id", "runtime_id", "runtime_epoch", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "session.catalog" },
        "request_id": { "$ref": "#/$defs/uuid" }, "runtime_id": { "$ref": "#/$defs/uuid" },
        "runtime_epoch": { "$ref": "#/$defs/uuid" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "index", "complete", "items"],
          "properties": {
            "mode": { "enum": ["snapshot", "delta"] },
            "index": { "type": "integer", "minimum": 0 },
            "complete": { "type": "boolean" },
            "items": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/sessionCatalogItem" } }
          }
        }
      }
    },
    "hostSessionCatalogAck": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "request_id", "runtime_id", "runtime_epoch", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "session.catalog.ack" },
        "request_id": { "$ref": "#/$defs/uuid" }, "runtime_id": { "$ref": "#/$defs/uuid" },
        "runtime_epoch": { "$ref": "#/$defs/uuid" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["session_count", "server_time"],
          "properties": {
            "session_count": { "type": "integer", "minimum": 0, "maximum": 20000 },
            "server_time": { "type": "string" }
          }
        }
      }
    },
    "hostCommandReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "request_id", "runtime_id", "runtime_epoch", "session_id", "device_id", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "command.receipt" },
        "request_id": { "$ref": "#/$defs/uuid" }, "runtime_id": { "$ref": "#/$defs/uuid" },
        "runtime_epoch": { "$ref": "#/$defs/uuid" }, "session_id": { "$ref": "#/$defs/uuid" },
        "device_id": { "$ref": "#/$defs/uuid" }, "payload": { "$ref": "#/$defs/hostReceiptPayload" }
      }
    },
    "hostReceiptPayload": {
      "type": "object", "additionalProperties": false, "required": ["state", "payload_sha256"],
      "properties": { "state": { "enum": ["host_accepted", "dispatching", "agent_queued", "observed", "settled", "rejected", "outcome_unknown"] }, "payload_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "deviceCommandReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["v", "type", "request_id", "runtime_id", "runtime_epoch", "session_id", "payload"],
      "properties": {
        "v": { "const": 1 }, "type": { "const": "command.receipt" },
        "request_id": { "$ref": "#/$defs/uuid" }, "runtime_id": { "$ref": "#/$defs/uuid" },
        "runtime_epoch": { "$ref": "#/$defs/uuid" }, "session_id": { "$ref": "#/$defs/uuid" },
        "payload": { "$ref": "#/$defs/deviceReceiptPayload" }
      }
    },
    "deviceReceiptPayload": {
      "type": "object", "additionalProperties": false, "required": ["state", "payload_sha256", "updated_at"],
      "properties": { "state": { "enum": ["received", "host_accepted", "dispatching", "agent_queued", "observed", "settled", "rejected", "outcome_unknown"] }, "payload_sha256": { "$ref": "#/$defs/sha256" }, "updated_at": { "type": "string" } }
    },
    "accessRevoked": {
      "type": "object", "additionalProperties": false, "required": ["v", "type", "payload"],
      "properties": { "v": { "const": 1 }, "type": { "const": "access.revoked" }, "payload": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "type": "string" } } } }
    },
    "runtimeChanged": {
      "type": "object", "additionalProperties": false, "required": ["v", "type", "payload"],
      "properties": { "v": { "const": 1 }, "type": { "const": "runtime.changed" }, "payload": { "type": "object", "additionalProperties": false, "required": ["runtime_id"], "properties": { "runtime_id": { "$ref": "#/$defs/uuid" } } } }
    },
    "serverDraining": {
      "type": "object", "additionalProperties": false, "required": ["v", "type", "payload"],
      "properties": { "v": { "const": 1 }, "type": { "const": "server.draining" }, "payload": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "const": "server_draining" } } } }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["v", "type", "payload"],
      "properties": { "v": { "const": 1 }, "type": { "const": "error" }, "request_id": { "$ref": "#/$defs/uuid" }, "runtime_id": { "$ref": "#/$defs/uuid" }, "session_id": { "$ref": "#/$defs/uuid" }, "payload": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "type": "string" } } } }
    }
  }
}
