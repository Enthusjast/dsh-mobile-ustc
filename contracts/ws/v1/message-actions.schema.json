{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-mobile-ustc:ws:message-actions:v1",
  "description": "Negotiated strict feature frames; references convey no authority. Current owner, resource, runtime epoch, reader sync, exact manifest/anchor and independent action/export grants remain runtime requirements.",
  "oneOf": [
    {
      "$ref": "#/$defs/messagePreviewGet"
    },
    {
      "$ref": "#/$defs/hostMessagePreviewGet"
    },
    {
      "$ref": "#/$defs/messagePreviewConfirm"
    },
    {
      "$ref": "#/$defs/hostMessagePreviewConfirm"
    },
    {
      "$ref": "#/$defs/messagePreviewResult"
    },
    {
      "$ref": "#/$defs/messagePreviewError"
    }
  ],
  "$defs": {
    "hostMessagePreviewConfirm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "request_id",
        "runtime_id",
        "runtime_epoch",
        "session_id",
        "subscription_id",
        "type",
        "user_id",
        "device_id",
        "payload"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_epoch": {
          "$ref": "#/$defs/uuid"
        },
        "session_id": {
          "$ref": "#/$defs/uuid"
        },
        "subscription_id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "session.message.preview.confirm"
        },
        "user_id": {
          "$ref": "#/$defs/uuid"
        },
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "payload": {
          "$ref": "#/$defs/messagePreviewConfirmRequest"
        }
      }
    },
    "hostMessagePreviewGet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "request_id",
        "runtime_id",
        "runtime_epoch",
        "session_id",
        "subscription_id",
        "type",
        "user_id",
        "device_id",
        "payload"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_epoch": {
          "$ref": "#/$defs/uuid"
        },
        "session_id": {
          "$ref": "#/$defs/uuid"
        },
        "subscription_id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "session.message.preview.get"
        },
        "user_id": {
          "$ref": "#/$defs/uuid"
        },
        "device_id": {
          "$ref": "#/$defs/uuid"
        },
        "payload": {
          "$ref": "#/$defs/messagePreviewRequest"
        }
      }
    },
    "messagePreview": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "anchor": {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "subscription_id": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "sync_id": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "native_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "message_version_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "anchor_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "v",
            "subscription_id",
            "sync_id",
            "native_seq",
            "message_version_sha256",
            "anchor_sha256"
          ],
          "additionalProperties": false
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            {
              "type": "null"
            }
          ]
        },
        "shareable": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "v",
        "anchor",
        "text",
        "shareable",
        "complete"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "shareable"
            ],
            "properties": {
              "shareable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              }
            }
          },
          "else": {
            "properties": {
              "text": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "Exact authorized persisted visible subset; <=32768 UTF-8 text bytes and <=48KiB serialized payload. Image/file-only messages retain real anchors with text=null/shareable=false. Share confirmation requires unchanged current-reader authorization; no invented text."
    },
    "messagePreviewConfirm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "request_id",
        "runtime_id",
        "runtime_epoch",
        "session_id",
        "subscription_id",
        "type",
        "payload"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_epoch": {
          "$ref": "#/$defs/uuid"
        },
        "session_id": {
          "$ref": "#/$defs/uuid"
        },
        "subscription_id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "session.message.preview.confirm"
        },
        "payload": {
          "$ref": "#/$defs/messagePreviewConfirmRequest"
        }
      }
    },
    "messagePreviewConfirmRequest": {
      "type": "object",
      "properties": {
        "sync_id": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "anchor": {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 1
            },
            "subscription_id": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "sync_id": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "native_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "message_version_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "anchor_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "v",
            "subscription_id",
            "sync_id",
            "native_seq",
            "message_version_sha256",
            "anchor_sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sync_id",
        "anchor"
      ],
      "additionalProperties": false
    },
    "messagePreviewError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "request_id",
        "runtime_id",
        "runtime_epoch",
        "session_id",
        "subscription_id",
        "type",
        "sync_id",
        "payload"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_epoch": {
          "$ref": "#/$defs/uuid"
        },
        "session_id": {
          "$ref": "#/$defs/uuid"
        },
        "subscription_id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "session.message.preview.error"
        },
        "sync_id": {
          "$ref": "#/$defs/uuid"
        },
        "payload": {
          "$ref": "#/$defs/readerErrorPayload"
        }
      }
    },
    "messagePreviewGet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "request_id",
        "runtime_id",
        "runtime_epoch",
        "session_id",
        "subscription_id",
        "type",
        "payload"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_epoch": {
          "$ref": "#/$defs/uuid"
        },
        "session_id": {
          "$ref": "#/$defs/uuid"
        },
        "subscription_id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "session.message.preview.get"
        },
        "payload": {
          "$ref": "#/$defs/messagePreviewRequest"
        }
      }
    },
    "messagePreviewRequest": {
      "type": "object",
      "properties": {
        "sync_id": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "native_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sync_id",
        "native_seq"
      ],
      "additionalProperties": false
    },
    "messagePreviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "request_id",
        "runtime_id",
        "runtime_epoch",
        "session_id",
        "subscription_id",
        "type",
        "sync_id",
        "payload"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_id": {
          "$ref": "#/$defs/uuid"
        },
        "runtime_epoch": {
          "$ref": "#/$defs/uuid"
        },
        "session_id": {
          "$ref": "#/$defs/uuid"
        },
        "subscription_id": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "session.message.preview.result"
        },
        "sync_id": {
          "$ref": "#/$defs/uuid"
        },
        "payload": {
          "$ref": "#/$defs/messagePreview"
        }
      }
    },
    "readerErrorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "session.not_found",
            "runtime.changed",
            "runtime.offline",
            "access.denied",
            "protocol.invalid",
            "protocol.snapshot_too_large",
            "protocol.resync_required",
            "rate.limited",
            "message.stale",
            "message.unavailable",
            "message.not_persisted",
            "changes.stale",
            "changes.unavailable",
            "changes.not_git",
            "changes.limit"
          ]
        }
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
